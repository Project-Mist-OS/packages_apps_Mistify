<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    android:key="canvas_aod_settings"
    android:title="@string/canvas_aod_title">

    <com.android.settingslib.widget.LayoutPreference
        android:key="canvas_aod_preview_card"
        android:layout="@layout/canvas_aod_preview"
        android:selectable="false" />

    <org.mist.settings.preferences.SecureSettingSwitchPreference
        android:key="canvas_aod_enabled"
        android:title="@string/canvas_aod_enabled_title"
        android:summary="@string/canvas_aod_enabled_summary"
        android:defaultValue="false" />

    <PreferenceCategory
        android:key="canvas_aod_style_category"
        android:title="@string/canvas_aod_style_category">

        <org.mist.settings.preferences.SecureSettingListPreference
            android:key="canvas_aod_style"
            android:title="@string/canvas_aod_style_title"
            android:summary="%s"
            android:entries="@array/canvas_aod_style_entries"
            android:entryValues="@array/canvas_aod_style_values"
            android:defaultValue="0" />

        <org.mist.settings.preferences.SecureSettingListPreference
            android:key="canvas_aod_outline_thickness"
            android:title="@string/canvas_aod_thickness_title"
            android:summary="%s"
            android:entries="@array/canvas_aod_thickness_entries"
            android:entryValues="@array/canvas_aod_thickness_values"
            android:defaultValue="1" />

        <org.mist.settings.preferences.SecureSettingListPreference
            android:key="canvas_aod_color_mode"
            android:title="@string/canvas_aod_color_mode_title"
            android:summary="%s"
            android:entries="@array/canvas_aod_color_mode_entries"
            android:entryValues="@array/canvas_aod_color_mode_values"
            android:defaultValue="1" />

        <org.mist.settings.preferences.colorpicker.SecureSettingColorPickerPreference
            android:key="canvas_aod_custom_color"
            android:title="@string/canvas_aod_custom_color_title"
            android:defaultValue="0xFFFFFFFF" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="canvas_aod_animation_category"
        android:title="@string/canvas_aod_animation_category">

        <org.mist.settings.preferences.SecureSettingSwitchPreference
            android:key="canvas_aod_animation_enabled"
            android:title="@string/canvas_aod_animation_enabled_title"
            android:summary="@string/canvas_aod_animation_enabled_summary"
            android:defaultValue="true" />

        <org.mist.settings.preferences.SecureSettingListPreference
            android:key="canvas_aod_animation_speed"
            android:title="@string/canvas_aod_animation_speed_title"
            android:summary="%s"
            android:entries="@array/canvas_aod_animation_speed_entries"
            android:entryValues="@array/canvas_aod_animation_speed_values"
            android:defaultValue="1"
            android:dependency="canvas_aod_animation_enabled" />

        <org.mist.settings.preferences.SecureSettingSwitchPreference
            android:key="canvas_aod_charging_animation"
            android:title="@string/canvas_aod_charging_anim_title"
            android:summary="@string/canvas_aod_charging_anim_summary"
            android:defaultValue="true" />

        <org.mist.settings.preferences.SecureSettingSwitchPreference
            android:key="canvas_aod_notification_pulse"
            android:title="@string/canvas_aod_notif_pulse_title"
            android:summary="@string/canvas_aod_notif_pulse_summary"
            android:defaultValue="true" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="canvas_aod_weather_category"
        android:title="@string/canvas_aod_weather_category">

        <org.mist.settings.preferences.SecureSettingSwitchPreference
            android:key="canvas_aod_weather_effects"
            android:title="@string/canvas_aod_weather_effects_title"
            android:summary="@string/canvas_aod_weather_effects_summary"
            android:defaultValue="false" />

        <org.mist.settings.preferences.SecureSettingListPreference
            android:key="canvas_aod_weather_intensity"
            android:title="@string/canvas_aod_weather_intensity_title"
            android:summary="%s"
            android:entries="@array/canvas_aod_weather_intensity_entries"
            android:entryValues="@array/canvas_aod_weather_intensity_values"
            android:defaultValue="1"
            android:dependency="canvas_aod_weather_effects" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="canvas_aod_actions_category"
        android:title="@string/canvas_aod_actions_category">

        <Preference
            android:key="canvas_aod_regenerate"
            android:title="@string/canvas_aod_regenerate_title"
            android:summary="@string/canvas_aod_regenerate_summary" />

    </PreferenceCategory>

    <com.android.settingslib.widget.FooterPreference
        android:key="canvas_aod_footer"
        android:title="@string/canvas_aod_footer_text"
        android:selectable="false" />

</PreferenceScreen>
