<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    android:title="@string/mist_dashboard_title">

   <PreferenceCategory
        android:key="top_level_mistify_ui"
        android:layout="@layout/settingslib_preference_category_no_title">

    <!-- Dashboard -->
    <Preference
        android:key="styles"
        android:title="@string/settings_styles"
        android:summary="@string/settings_summary"
        android:icon="@drawable/ic_home"
        settings:layout="@layout/mist_dashboard_single"
        android:fragment="org.mist.settings.fragments.UserInterface" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="top_level_personalize_monet"
        android:layout="@layout/settingslib_preference_category_no_title">
    
    <Preference
            android:key="monet_engine"
            android:title="@string/themes_monet_title"
            android:icon="@drawable/ic_monet"
            android:summary="@string/themes_monet_summary"
            settings:layout="@layout/mist_dashboard_single"
            android:fragment="org.mist.settings.fragments.themes.MonetSettings" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="top_level_personalize_themes"
        android:layout="@layout/settingslib_preference_category_no_title">

    <!-- Themes -->
    <Preference
        android:key="themes"
        android:title="@string/themes_title"
        android:summary="@string/themes_summary"
        android:icon="@drawable/ic_themes"
        settings:layout="@layout/mist_dashboard_single"
        android:fragment="org.mist.settings.fragments.themes.Themes" />

    </PreferenceCategory>
    <PreferenceCategory
        android:key="top_level_personalize_lockscreen"
        android:layout="@layout/settingslib_preference_category_no_title">
    <!-- Lock screen -->
    <Preference
        android:key="lock_screen"
        android:title="@string/lock_screen_title"
        android:summary="@string/lock_screen_summary"
        android:icon="@drawable/ic_lock_screen"
        settings:layout="@layout/mist_dashboard_single"
        android:fragment="org.mist.settings.fragments.lockscreen.LockScreen" />

    </PreferenceCategory>
    <PreferenceCategory
        android:key="top_level_personalize_status"
        android:layout="@layout/settingslib_preference_category_no_title">
    <!-- Status bar -->
    <Preference
        android:key="status_bar"
        android:title="@string/status_bar_title"
        android:summary="@string/status_bar_summary"
        android:icon="@drawable/ic_status_bar"
        settings:layout="@layout/mist_dashboard_single"
        android:fragment="org.mist.settings.fragments.statusbar.StatusBar" />

    </PreferenceCategory>
    <PreferenceCategory
        android:key="top_level_personalize_quick"
        android:layout="@layout/settingslib_preference_category_no_title">
    <!-- Quick settings -->
    <Preference
        android:key="quick_settings"
        android:title="@string/quick_settings_title"
        android:summary="@string/quick_settings_summary"
        android:icon="@drawable/ic_quick_settings"
        settings:layout="@layout/mist_dashboard_single"
        android:fragment="org.mist.settings.fragments.quicksettings.QuickSettings" />

    </PreferenceCategory>
    <PreferenceCategory
        android:key="top_level_personalize_noti"
        android:layout="@layout/settingslib_preference_category_no_title">
    <!-- Notifications -->
    <Preference
        android:key="notifications"
        android:title="@string/notifications_title"
        android:summary="@string/notifications_summary"
        android:icon="@drawable/ic_notifications"
        settings:layout="@layout/mist_dashboard_single"
        android:fragment="org.mist.settings.fragments.notifications.Notifications" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="top_level_personalize_power"
        android:layout="@layout/settingslib_preference_category_no_title">
        
    <!-- Power menu -->
    <Preference
        android:key="power_menu"
        android:title="@string/power_menu_title"
        android:summary="@string/power_menu_summary"
        android:icon="@drawable/ic_power_menu"
        settings:layout="@layout/mist_dashboard_single"
        android:fragment="org.mist.settings.fragments.powermenu.PowerMenu" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="top_level_personalize_misc"
        android:layout="@layout/settingslib_preference_category_no_title">

    <!-- Miscellaneous -->
    <Preference
        android:key="miscellaneous"
        android:title="@string/miscellaneous_title"
        android:summary="@string/miscellaneous_summary"
        android:icon="@drawable/ic_miscellaneous"
        settings:layout="@layout/mist_dashboard_single"
        android:fragment="org.mist.settings.fragments.miscellaneous.Miscellaneous" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="top_level_personalize_spoofing"
        android:layout="@layout/settingslib_preference_category_no_title">

    <!-- Component spoofing -->
        <Preference
            android:key="spoofing"
            android:title="@string/spoofing_title"
            android:summary="@string/spoofing_summary"
            android:icon="@drawable/ic_spoofing"
            settings:layout="@layout/mist_dashboard_single"
            android:fragment="org.mist.settings.fragments.miscellaneous.Spoofing" />
    </PreferenceCategory>


</PreferenceScreen>
