<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/mistos_donate_title"
        style="@style/TextAppearance.AppCompat.Headline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:layout_centerHorizontal="true"
        android:textSize="35dp"
        android:text="@string/mistos_donate_title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/mistos_donate_title"
        android:layout_marginEnd="@dimen/logo_horizontal_margin"
        android:layout_marginStart="@dimen/logo_horizontal_margin"
        android:layout_marginTop="@dimen/logo_vertical_margin"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="@dimen/logo_height"
            android:layout_marginEnd="2dp"
            android:layout_marginStart="2dp"
            android:adjustViewBounds="true"
            android:src="@drawable/banner" />

        <TextView
            android:id="@+id/mistos_donate_message"
            style="@style/TextAppearance.AppCompat.Subhead"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:text="@string/mistos_donate_message"
            android:textAlignment="center"
            android:textColor="?android:attr/textColorSecondary" />

        <ImageView
            android:layout_width="250dp"
            android:layout_height="200dp"
            android:background="@drawable/help"
            android:layout_margin="30dp"
            android:layout_gravity="center" />

        <Button
            android:id="@+id/mistos_donate_button"
            style="@style/Widget.AppCompat.Button.Borderless.Colored"
            android:layout_width="150dp"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:drawableStart="@drawable/ic_donate_notification"
            android:drawablePadding="8dp"
            android:text="@string/mistos_donate_button" />
    </LinearLayout>

    <Button
        android:id="@+id/mistos_later_button"
        style="@style/Base.Widget.AppCompat.Button.Colored"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="48dp"
        android:paddingBottom="8dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:text="@string/mistos_later_button" />
</RelativeLayout>
