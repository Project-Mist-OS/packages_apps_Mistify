<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="5dp">

        <!-- Monet Settings Section -->
        <org.mist.settings.utils.AnimatedMonetCardView
            android:id="@+id/card_monet"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="24dp"
                android:clickable="false"
                android:focusable="false">

                <TextView
                    android:id="@+id/text_monet_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Theme Engine"
                    android:textColor="#888888"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/text_monet_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/monet_settings_title"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:layout_marginTop="5dp"
                    android:gravity="center" />

                <org.mist.settings.utils.RandomAnimatedIconView
                    android:id="@+id/icon_monet"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_homepage_monet"
                    android:layout_marginTop="12dp"
                    android:layout_gravity="center_horizontal" />

            </LinearLayout>

        </org.mist.settings.utils.AnimatedMonetCardView>

        <!-- Middle Section: Quick Settings, Status Bar, Lockscreen -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Left Column: Quick Settings & Status Bar -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Quick Settings -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_qs"
                    android:layout_width="match_parent"
                    android:layout_height="172dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="28dp"
                    app:cardPreventCornerOverlap="false"
                    app:cardElevation="0dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="false"
                        android:focusable="false">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="16dp"
                            android:clickable="false"
                            android:focusable="false">

                            <TextView
                                android:id="@+id/qs_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="QuickSetting Tweeks"
                                android:textColor="#888888"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:id="@+id/qs_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="@string/quick_settings_title"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/qs_label" />

                            <org.mist.settings.utils.RandomAnimatedIconView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_mist_quick_settings"
                                android:layout_marginTop="12dp"
                                app:layout_constraintTop_toBottomOf="@id/qs_value"
                                app:layout_constraintStart_toStartOf="parent" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </FrameLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Status Bar -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_statusbar"
                    android:layout_width="match_parent"
                    android:layout_height="172dp"
                    android:layout_marginTop="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="16dp"
                        android:clickable="false"
                        android:focusable="false">

                        <TextView
                            android:id="@+id/sb_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Status bar Tweeks"
                            android:textColor="#888888"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/sb_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="@string/status_bar_title"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/sb_label" />

                        <org.mist.settings.utils.RandomAnimatedIconView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_mist_status_bar"
                            android:layout_marginTop="12dp"
                            app:layout_constraintTop_toBottomOf="@id/sb_value"
                            app:layout_constraintStart_toStartOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Right Column: Lockscreen -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="360dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_lockscreen"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp">

                    <!-- Blurred wallpaper background layer -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="false"
                        android:focusable="false">

                        <org.mist.settings.utils.BlurWallpaperView
                            android:id="@+id/lockscreen_blur_wallpaper"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:clickable="false"
                            android:focusable="false"
                            app:blurred="true" />

                        <!-- Dark scrim so text stays readable -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#66000000"
                            android:clickable="false"
                            android:focusable="false" />

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="16dp"
                            android:clickable="false"
                            android:focusable="false">

                            <TextView
                                android:id="@+id/ls_label"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/lock_screen_title_mist"
                                android:textColor="#FFFFFF"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent" />

                            <LinearLayout
                                android:id="@+id/clock_face_clock_preview_container"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:orientation="vertical"
                                android:gravity="center"
                                app:layout_constraintTop_toBottomOf="@id/ls_label"
                                app:layout_constraintBottom_toTopOf="@id/ls_icon"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent" >

                            <TextClock
                                    android:id="@+id/clock_face_hour_preview"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:format12Hour="hh"
                                    android:format24Hour="hh"
                                    android:textAlignment="center"
                                    android:textColor="#FF0000"
                                    android:fontFamily="@*android:string/config_bodyFontFamily"
                                    android:textStyle="bold"
                                    android:includeFontPadding="false"
                                    android:textSize="70sp" />

                                <TextClock
                                    android:id="@+id/clock_face_minute_preview"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:format12Hour="mm"
                                    android:format24Hour="mm"
                                    android:textAlignment="center"
                                    android:textColor="#FFFFFF"
                                    android:fontFamily="@*android:string/config_bodyFontFamily"
                                    android:textStyle="bold"
                                    android:includeFontPadding="false"
                                    android:textSize="55sp" />

                            </LinearLayout>

                            <org.mist.settings.utils.RandomAnimatedIconView
                                android:id="@+id/ls_icon"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:src="@drawable/ic_mist_lock_screen"
                                android:contentDescription="@null"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </FrameLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

        <!-- Themes and Spoofing Split Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="16dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Themes Section -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_themes"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="20dp"
                    android:clickable="false"
                    android:focusable="false">

                    <TextView
                        android:id="@+id/themes_main_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Device Visuals Tweeks"
                        android:textColor="#888888"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_centerHorizontal="true"
                        android:layout_alignParentTop="true" />

                    <TextView
                        android:id="@+id/themes_main_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/themes_title"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_centerInParent="true" />

                    <org.mist.settings.utils.RandomAnimatedIconView
                        android:id="@+id/themes_main_icon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_mist_themes"
                        android:layout_centerHorizontal="true"
                        android:layout_alignParentBottom="true" />

                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Small Pill Divider -->
            <View
                android:layout_width="4dp"
                android:layout_height="64dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/ic_pill" />

            <!-- Spoofing Section -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_spoofing"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="28dp"
                app:cardPreventCornerOverlap="false"
                app:cardElevation="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="false"
                    android:focusable="false">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="20dp"
                        android:clickable="false"
                        android:focusable="false">

                        <TextView
                            android:id="@+id/spoofing_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Device Certifications Tweeks"
                            android:textColor="#888888"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_centerHorizontal="true"
                            android:layout_alignParentTop="true" />

                        <TextView
                            android:id="@+id/spoofing_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/spoofing_title"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_centerInParent="true" />

                        <org.mist.settings.utils.RandomAnimatedIconView
                            android:id="@+id/icon_spoofing"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_homepage_spoof"
                            android:layout_centerHorizontal="true"
                            android:layout_alignParentBottom="true" />

                    </RelativeLayout>

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Rest Settings: Horizontal Scroll -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:fillViewport="true"
            android:paddingBottom="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Misc Settings Card 1 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_misc"
                    android:layout_width="140dp"
                    android:layout_height="160dp"
                    android:layout_marginEnd="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="16dp"
                        android:clickable="false"
                        android:focusable="false">

                        <TextView
                            android:id="@+id/misc1_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Misc Settings"
                            android:textColor="#888888"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/misc1_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/misc2_title"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toTopOf="@id/misc1_icon"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/misc1_label" />

                        <org.mist.settings.utils.RandomAnimatedIconView
                            android:id="@+id/misc1_icon"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/ic_mist_miscellaneous"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Misc Settings Card 2 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_buttons"
                    android:layout_width="140dp"
                    android:layout_height="160dp"
                    android:layout_marginEnd="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="16dp"
                        android:clickable="false"
                        android:focusable="false">

                        <TextView
                            android:id="@+id/misc2_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TOOLS"
                            android:textColor="#888888"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/misc2_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/buttons_title"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toTopOf="@id/misc2_icon"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/misc2_label" />

                        <org.mist.settings.utils.RandomAnimatedIconView
                            android:id="@+id/misc2_icon"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/ic_mist_power_menu"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Misc Settings Card 3 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_sound"
                    android:layout_width="140dp"
                    android:layout_height="160dp"
                    android:layout_marginEnd="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="16dp"
                        android:clickable="false"
                        android:focusable="false">

                        <TextView
                            android:id="@+id/misc3_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sounds Tweeks"
                            android:textColor="#888888"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/misc3_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sound_title"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toTopOf="@id/misc3_icon"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/misc3_label" />

                        <org.mist.settings.utils.RandomAnimatedIconView
                            android:id="@+id/misc3_icon"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/ic_homepage_sound"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Misc Settings Card 4 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_extras"
                    android:layout_width="140dp"
                    android:layout_height="160dp"
                    android:layout_marginEnd="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="16dp"
                        android:clickable="false"
                        android:focusable="false">

                        <TextView
                            android:id="@+id/misc4_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Extra Tweeks"
                            android:textColor="#888888"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/misc4_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/extras_title"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toTopOf="@id/misc4_icon"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/misc4_label" />

                        <org.mist.settings.utils.RandomAnimatedIconView
                            android:id="@+id/misc4_icon"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/ic_homepage_extras"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Misc Settings Card 6 (Notifications) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_notifications"
                    android:layout_width="140dp"
                    android:layout_height="160dp"
                    android:layout_marginEnd="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="16dp"
                        android:clickable="false"
                        android:focusable="false">

                        <TextView
                            android:id="@+id/misc6_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Alert Tweeks"
                            android:textColor="#888888"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/misc6_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/notifi_title"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toTopOf="@id/misc6_icon"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/misc6_label" />

                        <org.mist.settings.utils.RandomAnimatedIconView
                            android:id="@+id/misc6_icon"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/ic_homepage_notification"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Misc Settings Card 7 (About) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_about"
                    android:layout_width="140dp"
                    android:layout_height="160dp"
                    android:layout_marginEnd="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="16dp"
                        android:clickable="false"
                        android:focusable="false">

                        <TextView
                            android:id="@+id/misc7_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rom Info"
                            android:textColor="#888888"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/misc7_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/about_title"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toTopOf="@id/misc7_icon"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/misc7_label" />

                        <org.mist.settings.utils.RandomAnimatedIconView
                            android:id="@+id/misc7_icon"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/ic_homepage_about"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

