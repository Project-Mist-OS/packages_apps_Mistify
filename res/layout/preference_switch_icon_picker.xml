<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="16dp">

    <!-- Live preview. Drawn by the same code as the real switches, so it looks identical -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/switch_icon_preview_bg"
        android:orientation="horizontal"
        android:paddingVertical="28dp"
        android:weightSum="2">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <org.mist.settings.preferences.SwitchPreviewView
                android:id="@+id/preview_switch_off"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/preview_label_off"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/switch_icon_preview_off"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="@color/settingslib_materialColorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <org.mist.settings.preferences.SwitchPreviewView
                android:id="@+id/preview_switch_on"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/preview_label_on"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="@color/settingslib_materialColorOnSurface" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp"
        android:text="@string/switch_icon_choose_title"
        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
        android:textColor="@color/settingslib_materialColorOnSurface" />

    <!-- Grid of icons; sized to its content because the page itself scrolls -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/switch_icon_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never" />

    <TextView
        android:id="@+id/switch_icon_upload"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/switch_icon_upload_bg"
        android:clickable="true"
        android:drawablePadding="8dp"
        android:drawableStart="@drawable/ic_switch_icon_add"
        android:drawableTint="@color/settingslib_materialColorOnPrimary"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="56dp"
        android:paddingHorizontal="24dp"
        android:text="@string/switch_icon_upload"
        android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
        android:textColor="@color/settingslib_materialColorOnPrimary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="4dp"
        android:text="@string/switch_icon_hint"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textColor="@color/settingslib_materialColorOnSurfaceVariant" />
</LinearLayout>
