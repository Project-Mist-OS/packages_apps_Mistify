<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/switch_style_selected_background" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="@color/switch_selection_color" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/switch_style_background" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/switch_style_border" />
        </shape>
    </item>
</selector>
