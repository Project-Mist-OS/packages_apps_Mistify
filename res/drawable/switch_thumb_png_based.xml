<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <bitmap android:src="@drawable/switch_thumb_disabled_png" 
                android:gravity="center" />
    </item>
    <item android:state_checked="true">
        <bitmap android:src="@drawable/switch_thumb_on_png" 
                android:gravity="center" />
    </item>
    <item>
        <bitmap android:src="@drawable/switch_thumb_off_png" 
                android:gravity="center" />
    </item>
</selector>
