<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Track -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/custom_switch_track_color" />
            <corners android:radius="@dimen/custom_switch_corner_radius" />
        </shape>
    </item>
    <!-- Thumb -->
    <item android:left="20dp" android:top="4dp" android:bottom="4dp" android:right="4dp">
        <shape android:shape="oval">
            <solid android:color="@color/custom_switch_thumb_color" />
        </shape>
    </item>
</layer-list>
